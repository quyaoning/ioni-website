---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { url } from '../lib/url';

const links = [
  { href: '/', label: 'Home' },
  { href: '/subteams/', label: 'Subteams' },
  { href: '/research/', label: 'Research' },
  { href: '/gallery/', label: 'Gallery' },
];

const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={url('/')}>
      <Image src={logo} alt="" width={36} height={36} loading="eager" />
      <span class="brand-text">
        <strong>ION-I</strong>
        <span>Electric Propulsion Initiative</span>
      </span>
    </a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">Menu</span>
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"
        ><path d="M3 7h18M3 12h18M3 17h18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
        ></path></svg
      >
    </button>
    <nav id="site-nav" aria-label="Main">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={url(l.href)} aria-current={isActive(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('open', !open);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(6, 14, 26, 0.78);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.7em;
    text-decoration: none;
    color: var(--text);
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .brand-text strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: 0.02em;
  }
  .brand-text span {
    font-size: 0.72rem;
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: 0.45em 0.9em;
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.95rem;
    transition: color 0.15s, background 0.15s;
  }
  nav a:hover {
    color: var(--text);
    background: rgba(120, 190, 255, 0.08);
  }
  nav a[aria-current='page'] {
    color: var(--text);
    background: var(--cyan-dim);
  }
  .menu-toggle {
    display: none;
    background: none;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    color: var(--text);
    padding: 7px;
    cursor: pointer;
  }
  @media (max-width: 720px) {
    .menu-toggle {
      display: inline-flex;
    }
    nav {
      display: none;
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      background: rgba(6, 14, 26, 0.97);
      border-bottom: 1px solid var(--line);
      padding: 0.5rem var(--gutter) 1rem;
    }
    nav.open {
      display: block;
    }
    nav ul {
      flex-direction: column;
    }
    nav a {
      padding: 0.75em 0.9em;
    }
  }
</style>
