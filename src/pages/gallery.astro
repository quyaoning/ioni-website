---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { albums } from '../data/gallery';
---

<Base title="Gallery" description="Photos of ION-I's plasma tests, lab work, events, and CAD.">
  <PageHeader eyebrow="Gallery" title="Plasma, hardware, and people." lede="Select a photo to open it at full size." />

  {
    albums.map((album) => (
      <section class="section album">
        <div class="container">
          <h2>{album.title}</h2>
          <div class="grid">
            {album.shots.map((s) => (
              <figure>
                <a href={s.src.src} target="_blank" rel="noopener">
                  <Image src={s.src} alt={s.alt} widths={[400, 800]} sizes="(max-width: 600px) 100vw, (max-width: 1000px) 50vw, 360px" />
                </a>
                <figcaption>{s.caption}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    ))
  }
</Base>

<style>
  .album h2 {
    font-size: 1.5rem;
    margin-bottom: 1.2rem;
  }
  .album {
    padding: clamp(40px, 6vw, 64px) 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  figure {
    margin: 0;
  }
  figure a {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: #0b1626;
  }
  figure img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.35s;
  }
  figure a:hover img {
    transform: scale(1.03);
  }
  figcaption {
    margin-top: 0.55rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
</style>
