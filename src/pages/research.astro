---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { works } from '../data/research';
---

<Base title="Research" description="Posters, talks, papers, and references from ION-I's electric propulsion research.">
  <PageHeader
    eyebrow="Research"
    title="Our technical record."
    lede="Posters, talks, and papers from across the club, plus the references our designs build on. Every figure we publish will note its source data, units, and model assumptions."
  />

  <section class="section">
    <div class="container">
      <ol class="works">
        {
          works.map((w) => (
            <li class="work card">
              <div class="work-meta">
                <span class={w.kind === 'Reference' ? 'tag tag-cyan' : 'tag'}>{w.kind}</span>
                <span class="work-date">{w.date}</span>
                {w.status && <span class="status">{w.status}</span>}
              </div>
              <h2>{w.title}</h2>
              <p class="venue">{w.venue}</p>
              {w.authors && <p class="authors">{w.authors}</p>}
              <p class="summary">{w.summary}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container soon">
      <div>
        <span class="eyebrow">Coming this semester</span>
        <h2>Interactive viewers.</h2>
        <p class="lede">
          Simulation results rendered live in your browser: particle trajectories through the cathode, field maps, and
          cutaway CAD. Data is precomputed in Python and loaded here, so nothing needs a server.
        </p>
      </div>
      <div class="soon-box" aria-hidden="true">
        <svg viewBox="0 0 200 140">
          <defs>
            <radialGradient id="g" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#bb7cff" stop-opacity="0.6"></stop>
              <stop offset="100%" stop-color="#bb7cff" stop-opacity="0"></stop>
            </radialGradient>
          </defs>
          <ellipse cx="100" cy="70" rx="80" ry="46" fill="url(#g)"></ellipse>
          <path d="M20 70 C 60 30, 140 110, 180 70" stroke="#38d6f7" stroke-width="1.5" fill="none" opacity="0.8"></path>
          <path d="M20 80 C 70 40, 130 120, 180 60" stroke="#f7ab2e" stroke-width="1.5" fill="none" opacity="0.7"></path>
          <path d="M20 60 C 60 100, 140 20, 180 80" stroke="#38d6f7" stroke-width="1" fill="none" opacity="0.45"></path>
        </svg>
      </div>
    </div>
  </section>
</Base>

<style>
  .works {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .work {
    padding: clamp(20px, 3vw, 30px);
  }
  .work-meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-bottom: 0.8rem;
  }
  .work-date {
    font-size: 0.86rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .status {
    font-size: 0.8rem;
    color: var(--plasma);
    font-weight: 600;
  }
  .status::before {
    content: '● ';
  }
  .work h2 {
    font-size: 1.35rem;
    margin-bottom: 0.3em;
  }
  .venue {
    color: var(--cyan);
    font-size: 0.93rem;
    margin-bottom: 0.4em;
  }
  .authors {
    color: var(--muted);
    font-size: 0.86rem;
    margin-bottom: 0.8em;
  }
  .summary {
    margin: 0;
    max-width: 80ch;
  }
  .soon {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(24px, 5vw, 64px);
    align-items: center;
  }
  .soon-box {
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    padding: 24px;
    background: var(--bg-2);
  }
  @media (max-width: 760px) {
    .soon {
      grid-template-columns: 1fr;
    }
  }
</style>
