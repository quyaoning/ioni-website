---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const subteams = (await getCollection('subteams')).sort((a, b) => a.data.order - b.data.order);
  return subteams.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: subteams[(i + 1) % subteams.length] },
  }));
}

interface Props {
  entry: CollectionEntry<'subteams'>;
  next: CollectionEntry<'subteams'>;
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <article>
    <header class="head">
      <div class="container head-grid">
        <div>
          <a class="back" href={url('/subteams/')}>← All subteams</a>
          <span class="eyebrow">{entry.data.stage}</span>
          <h1>{entry.data.title}</h1>
          <p class="lede">{entry.data.summary}</p>
          <span class="tag">{entry.data.status}</span>
        </div>
        <Image src={entry.data.cover} alt={entry.data.coverAlt} widths={[600, 1100]} sizes="(max-width: 860px) 100vw, 520px" class="cover" loading="eager" />
      </div>
    </header>
    <section class="section">
      <div class="container">
        <div class="prose">
          <Content />
        </div>
        <a class="next card" href={url(`/subteams/${next.id}/`)}>
          <span>Next subteam</span>
          <strong>{next.data.title} →</strong>
        </a>
      </div>
    </section>
  </article>
</Base>

<style>
  .head {
    padding: clamp(40px, 7vw, 80px) 0;
    border-bottom: 1px solid var(--line);
    background: radial-gradient(ellipse 60% 80% at 85% 0%, rgba(123, 92, 255, 0.12), transparent 70%);
  }
  .head-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(24px, 5vw, 64px);
    align-items: center;
  }
  .back {
    display: block;
    width: fit-content;
    margin-bottom: 1.6rem;
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--muted);
  }
  .back:hover {
    color: var(--text);
  }
  h1 {
    font-size: clamp(2.2rem, 4.8vw, 3.5rem);
  }
  .cover {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: #cfd6de;
  }
  .next {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    max-width: 70ch;
    margin-top: 3rem;
    padding: 18px 22px;
    text-decoration: none;
    color: var(--text);
  }
  .next:hover {
    color: var(--text);
    border-color: rgba(56, 214, 247, 0.45);
  }
  .next span {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .next strong {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--cyan);
  }
  @media (max-width: 860px) {
    .head-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
